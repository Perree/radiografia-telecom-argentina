# Copiar como .env, que esta excluido del repositorio, o usar variables de entorno.
# Token personal de administracion de Supabase, NO una clave publica de la API de datos.
# No compartir el token por chat ni ponerlo en codigo o capturas.
SUPABASE_ACCESS_TOKEN=
# Referencia publica del UNICO proyecto autorizado.
SUPABASE_PROJECT_REF=tu_project_ref
